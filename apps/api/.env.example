# Salin file ini menjadi .env lalu sesuaikan.
# Laragon default: user root, password kosong, port 3306.
DATABASE_URL="mysql://root@localhost:3306/sipus"
JWT_ACCESS_SECRET="ganti-dengan-secret-acak-yang-kuat"
JWT_REFRESH_SECRET="ganti-dengan-secret-acak-lain-yang-kuat"
JWT_ACCESS_EXPIRES="2h"
JWT_REFRESH_EXPIRES="7d"
# Port API — 3001 dipakai karena port 3000 sering dipakai project lain
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
